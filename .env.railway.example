# ── Django ──────────────────────────
SECRET_KEY=your-strong-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app

# ── Database ─────────────────────────
# Railway sets this automatically 
# when you add a PostgreSQL service
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Email (Gmail SMTP) ───────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youremail@gmail.com
EMAIL_HOST_PASSWORD=your16charapppassword
DEFAULT_FROM_EMAIL=FUTB Smart Campus <youremail@gmail.com>

# ── Firebase ─────────────────────────
# Paste the base64 output from Step 10
FIREBASE_CREDENTIALS_BASE64=your-base64-string-here

# ── Paystack ─────────────────────────
PAYSTACK_SECRET_KEY=sk_live_your_key_here

# ── Google OAuth ─────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
